<?xml version="1.0" encoding="UTF-8"?>
<!-- Meeting minutes for LibreOffice to save as .docx: tracked changes, comments, a table of contents,
     page number fields, bookmarks and a cross-reference, a frame, a two-column section, footnotes and
     endnotes, an outline-numbered heading list. Fictional content only. -->
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0"
  xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0"
  xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0"
  xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0"
  xmlns:draw="urn:oasis:names:tc:opendocument:xmlns:drawing:1.0"
  xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0"
  xmlns:xlink="http://www.w3.org/1999/xlink"
  xmlns:dc="http://purl.org/dc/elements/1.1/"
  xmlns:meta="urn:oasis:names:tc:opendocument:xmlns:meta:1.0"
  xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0"
  office:version="1.3" office:mimetype="application/vnd.oasis.opendocument.text">
 <office:meta>
  <dc:title>Committee minutes</dc:title>
  <meta:initial-creator>Committee Secretary</meta:initial-creator>
  <dc:creator>Committee Secretary</dc:creator>
 </office:meta>
 <office:styles>
  <style:style style:name="Standard" style:family="paragraph">
   <style:paragraph-properties fo:margin-bottom="0.2cm"/>
   <style:text-properties fo:font-size="11pt"/>
  </style:style>
  <style:style style:name="Heading" style:family="paragraph" style:parent-style-name="Standard">
   <style:text-properties fo:font-size="14pt" fo:font-weight="bold"/>
  </style:style>
  <style:style style:name="Heading_20_1" style:display-name="Heading 1" style:family="paragraph" style:parent-style-name="Heading" style:default-outline-level="1">
   <style:text-properties fo:font-size="16pt"/>
  </style:style>
  <style:style style:name="Heading_20_2" style:display-name="Heading 2" style:family="paragraph" style:parent-style-name="Heading" style:default-outline-level="2"/>
  <style:style style:name="Header" style:family="paragraph" style:parent-style-name="Standard"/>
  <style:style style:name="Footer" style:family="paragraph" style:parent-style-name="Standard"/>
  <text:outline-style style:name="Outline">
   <text:outline-level-style text:level="1" style:num-format="1" style:num-suffix="."/>
   <text:outline-level-style text:level="2" style:num-format="1" text:display-levels="2" style:num-suffix="."/>
  </text:outline-style>
  <text:notes-configuration text:note-class="footnote" style:num-format="1" text:start-value="0" text:footnotes-position="page" text:start-numbering-at="document"/>
  <text:notes-configuration text:note-class="endnote" style:num-format="i" text:start-value="0"/>
 </office:styles>
 <office:automatic-styles>
  <style:style style:name="P1" style:family="paragraph" style:parent-style-name="Standard">
   <style:paragraph-properties fo:text-align="center"/>
  </style:style>
  <style:style style:name="P2" style:family="paragraph" style:parent-style-name="Standard">
   <style:paragraph-properties fo:break-before="page"/>
  </style:style>
  <style:style style:name="T1" style:family="text"><style:text-properties fo:font-weight="bold"/></style:style>
  <style:style style:name="T2" style:family="text"><style:text-properties fo:font-style="italic" fo:color="#7f1f1f"/></style:style>
  <style:style style:name="T3" style:family="text"><style:text-properties fo:background-color="#ffff00"/></style:style>
  <style:style style:name="Sect1" style:family="section">
   <style:section-properties><style:columns fo:column-count="2" fo:column-gap="0.6cm"/></style:section-properties>
  </style:style>
  <style:style style:name="fr1" style:family="graphic">
   <style:graphic-properties style:wrap="parallel" style:vertical-pos="top" style:vertical-rel="paragraph" style:horizontal-pos="right" style:horizontal-rel="paragraph" fo:border="0.06pt solid #000000" fo:padding="0.15cm"/>
  </style:style>
  <style:style style:name="Tbl" style:family="table"><style:table-properties style:width="16cm" table:align="margins"/></style:style>
  <style:style style:name="Tbl.A1" style:family="table-cell"><style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.1cm"/></style:style>
  <style:page-layout style:name="pm1">
   <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-top="2cm" fo:margin-bottom="2cm" fo:margin-left="2.5cm" fo:margin-right="2.5cm"/>
   <style:header-style><style:header-footer-properties fo:min-height="0.6cm" fo:margin-bottom="0.3cm"/></style:header-style>
   <style:footer-style><style:header-footer-properties fo:min-height="0.6cm" fo:margin-top="0.3cm"/></style:footer-style>
  </style:page-layout>
 </office:automatic-styles>
 <office:master-styles>
  <style:master-page style:name="Standard" style:page-layout-name="pm1">
   <style:header><text:p text:style-name="Header">Committee minutes · <text:span text:style-name="T2">draft</text:span></text:p></style:header>
   <style:footer><text:p text:style-name="P1">Page <text:page-number text:select-page="current">1</text:page-number> of <text:page-count>2</text:page-count></text:p></style:footer>
  </style:master-page>
 </office:master-styles>
 <office:body>
  <office:text>
   <text:tracked-changes>
    <text:changed-region text:id="ct1"><text:insertion><office:change-info><dc:creator>Committee Secretary</dc:creator><dc:date>2026-09-14T10:15:00</dc:date></office:change-info></text:insertion></text:changed-region>
    <text:changed-region text:id="ct2"><text:deletion><office:change-info><dc:creator>Committee Chair</dc:creator><dc:date>2026-09-14T11:02:00</dc:date></office:change-info><text:p>fourteen</text:p></text:deletion></text:changed-region>
   </text:tracked-changes>
   <text:p text:style-name="P1"><text:span text:style-name="T1">Committee minutes, 14 September</text:span></text:p>
   <text:table-of-content text:name="Table of Contents1">
    <text:table-of-content-source text:outline-level="2"><text:index-title-template>Contents</text:index-title-template></text:table-of-content-source>
    <text:index-body>
     <text:index-title text:name="Table of Contents1_Head"><text:p text:style-name="Heading">Contents</text:p></text:index-title>
     <text:p text:style-name="Standard">1. Attendance<text:tab/>1</text:p>
     <text:p text:style-name="Standard">2. Decisions<text:tab/>1</text:p>
     <text:p text:style-name="Standard">3. Actions<text:tab/>2</text:p>
    </text:index-body>
   </text:table-of-content>
   <text:h text:style-name="Heading_20_1" text:outline-level="1"><text:bookmark-start text:name="attendance"/>Attendance<text:bookmark-end text:name="attendance"/></text:h>
   <text:p text:style-name="Standard">Present: <text:change text:change-id="ct2"/>twelve members<text:change-start text:change-id="ct1"/> and two observers<text:change-end text:change-id="ct1"/>. Apologies were received from three members.<text:note text:id="ftn1" text:note-class="footnote"><text:note-citation>1</text:note-citation><text:note-body><text:p text:style-name="Standard">Two apologies arrived after the meeting.</text:p></text:note-body></text:note></text:p>
   <text:p text:style-name="Standard"><office:annotation><dc:creator>Committee Chair</dc:creator><dc:date>2026-09-15T09:00:00</dc:date><text:p>Please check the quorum rule.</text:p></office:annotation>The meeting was quorate<office:annotation-end/> and opened at <text:span text:style-name="T3">18:00</text:span>.</text:p>
   <text:h text:style-name="Heading_20_1" text:outline-level="1">Decisions</text:h>
   <text:p text:style-name="Standard"><draw:frame draw:style-name="fr1" draw:name="Note frame" text:anchor-type="paragraph" svg:width="5cm" draw:z-index="0"><draw:text-box fo:min-height="1cm"><text:p text:style-name="Standard">Budget approved unanimously.</text:p></draw:text-box></draw:frame>The committee approved the budget for next year and agreed to review the venue contract. See <text:bookmark-ref text:reference-format="text" text:ref-name="attendance">Attendance</text:bookmark-ref> for who voted.<text:note text:id="edn1" text:note-class="endnote"><text:note-citation>i</text:note-citation><text:note-body><text:p text:style-name="Standard">The vote was recorded by show of hands.</text:p></text:note-body></text:note></text:p>
   <text:h text:style-name="Heading_20_2" text:outline-level="2">Venue</text:h>
   <text:section text:style-name="Sect1" text:name="Columns">
    <text:p text:style-name="Standard">The current venue costs more each year, and the hall is often too small for the open meetings held in spring and autumn.</text:p>
    <text:p text:style-name="Standard">Two other halls were suggested; both have step-free access and are close to public transport, and one has a kitchen.</text:p>
   </text:section>
   <text:h text:style-name="Heading_20_1" text:outline-level="1">Actions</text:h>
   <table:table table:name="Actions" table:style-name="Tbl">
    <table:table-column table:number-columns-repeated="3"/>
    <table:table-header-rows>
     <table:table-row>
      <table:table-cell table:style-name="Tbl.A1"><text:p text:style-name="Standard"><text:span text:style-name="T1">Action</text:span></text:p></table:table-cell>
      <table:table-cell table:style-name="Tbl.A1"><text:p text:style-name="Standard"><text:span text:style-name="T1">Owner</text:span></text:p></table:table-cell>
      <table:table-cell table:style-name="Tbl.A1"><text:p text:style-name="Standard"><text:span text:style-name="T1">Due</text:span></text:p></table:table-cell>
     </table:table-row>
    </table:table-header-rows>
    <table:table-row>
     <table:table-cell table:style-name="Tbl.A1"><text:p text:style-name="Standard">Visit both halls</text:p></table:table-cell>
     <table:table-cell table:style-name="Tbl.A1"><text:p text:style-name="Standard">Secretary</text:p></table:table-cell>
     <table:table-cell table:style-name="Tbl.A1"><text:p text:style-name="Standard">October</text:p></table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Tbl.A1" table:number-columns-spanned="2"><text:p text:style-name="Standard">Report back at the next meeting</text:p></table:table-cell>
     <table:covered-table-cell/>
     <table:table-cell table:style-name="Tbl.A1"><text:p text:style-name="Standard">November</text:p></table:table-cell>
    </table:table-row>
   </table:table>
   <text:list>
    <text:list-item><text:p text:style-name="Standard">Circulate these minutes within a week.</text:p></text:list-item>
    <text:list-item><text:p text:style-name="Standard">Book the room for the next meeting.</text:p></text:list-item>
   </text:list>
   <text:p text:style-name="P2">Next meeting: <text:date text:date-value="2026-10-12">12 October</text:date>, same time.</text:p>
  </office:text>
 </office:body>
</office:document>
